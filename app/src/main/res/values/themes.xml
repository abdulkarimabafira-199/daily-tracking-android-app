<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AliCalendar" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand colors -->
        <item name="colorPrimary">@color/ali_indigo</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/ali_teal</item>
        <item name="colorOnSecondary">@color/text_dark</item>

        <!-- Background and Surface -->
        <item name="android:windowBackground">@color/background_gray</item>
        <item name="colorSurface">@color/surface_white</item>
        <item name="colorOnSurface">@color/text_dark</item>
        <item name="colorSurfaceVariant">@color/background_gray</item>
        <item name="colorOnSurfaceVariant">@color/text_light</item>

        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/text_dark</item>
        <item name="android:textColorSecondary">@color/text_light</item>
        <item name="android:textColorHint">@color/text_muted</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/surface_white</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Others -->
        <item name="colorOutline">@color/divider</item>
        <item name="android:stateListAnimator">@animator/button_burst</item>
    </style>

    <style name="Theme.AliCalendar" parent="Base.Theme.AliCalendar" />

    <style name="WeekdayLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_light</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
