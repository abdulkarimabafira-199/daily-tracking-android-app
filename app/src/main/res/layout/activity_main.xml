<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_gray"
    tools:openDrawer="start">

    <!-- ===================== MAIN CONTENT ===================== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/calendarRoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="28dp"
                android:paddingBottom="18dp">

                <ImageButton
                    android:id="@+id/btnMenu"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Menu"
                    android:src="@drawable/ic_menu"
                    app:layout_constraintBottom_toBottomOf="@id/tvTodayDate"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvAppTitle"
                    app:tint="@color/text_dark" />

                <!-- App title -->
                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/app_name"
                    android:textColor="@color/text_dark"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:ellipsize="end"
                    android:maxLines="1"
                    app:layout_constraintStart_toEndOf="@id/btnMenu"
                    app:layout_constraintEnd_toStartOf="@id/llBadges"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Today's Date -->
                <TextView
                    android:id="@+id/tvTodayDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/ali_green"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@id/tvAppTitle"
                    app:layout_constraintTop_toBottomOf="@id/tvAppTitle"
                    tools:text="31/02/2026" />

                <!-- Days counted badge -->
                <LinearLayout
                    android:id="@+id/llBadges"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    app:layout_constraintBottom_toBottomOf="@id/tvTodayDate"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvAppTitle">

                    <TextView
                        android:id="@+id/tvStreak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/streak_badge_bg"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:text="🔥3"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/llDaysCounted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/counter_badge_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="4dp"
                            android:src="@drawable/ic_arrow_drop_down"
                            app:tint="@color/white" />

                    <TextView
                        android:id="@+id/tvDaysCounted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        tools:text="0 days counted" />

                    </LinearLayout>
                </LinearLayout>

                <!-- Month navigation row -->
                <ImageButton
                    android:id="@+id/btnPrevMonth"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/nav_arrow_bg"
                    android:contentDescription="@string/app_name"
                    android:elevation="1dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_chevron_left"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTodayDate" />

                <LinearLayout
                    android:id="@+id/llMonthPicker"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:layout_constraintBottom_toBottomOf="@id/btnPrevMonth"
                    app:layout_constraintEnd_toStartOf="@id/btnNextMonth"
                    app:layout_constraintStart_toEndOf="@id/btnPrevMonth"
                    app:layout_constraintTop_toTopOf="@id/btnPrevMonth">

                    <TextView
                        android:id="@+id/tvMonthYear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_dark"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="July 2026" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_arrow_drop_down"
                        app:tint="@color/text_dark" />

                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnNextMonth"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/nav_arrow_bg"
                    android:contentDescription="@string/app_name"
                    android:elevation="1dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_chevron_right"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/btnPrevMonth" />

                <!-- Calendar card -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/calendarCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/calendar_card_bg"
                    android:elevation="2dp"
                    android:padding="16dp"
                    app:layout_constraintTop_toBottomOf="@id/btnPrevMonth">

                    <!-- Weekday labels -->
                    <LinearLayout
                        android:id="@+id/weekdayRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView style="@style/WeekdayLabel" android:text="Sun" android:textColor="@color/ali_bright_green" />
                        <TextView style="@style/WeekdayLabel" android:text="Mon" />
                        <TextView style="@style/WeekdayLabel" android:text="Tue" />
                        <TextView style="@style/WeekdayLabel" android:text="Wed" />
                        <TextView style="@style/WeekdayLabel" android:text="Thu" />
                        <TextView style="@style/WeekdayLabel" android:text="Fri" />
                        <TextView style="@style/WeekdayLabel" android:text="Sat" android:textColor="@color/ali_bright_green" />
                    </LinearLayout>

                    <View
                        android:id="@+id/weekdayDivider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:background="@color/divider"
                        app:layout_constraintTop_toBottomOf="@id/weekdayRow" />

                    <!-- Day grid -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvDays"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:overScrollMode="never"
                        app:layout_constraintTop_toBottomOf="@id/weekdayDivider" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Stats Card -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/statsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="32dp"
                    android:background="@drawable/calendar_card_bg"
                    android:elevation="2dp"
                    android:padding="20dp"
                    app:layout_constraintVertical_bias="0"
                    app:layout_constraintTop_toBottomOf="@id/calendarCard"
                    app:layout_constraintBottom_toBottomOf="parent">

                <LinearLayout
                    android:id="@+id/llTodayStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/counter_badge_bg"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <View
                        android:id="@+id/vStatusDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/welcome_circle_soft"
                        android:backgroundTint="@color/ali_coral" />

                    <TextView
                        android:id="@+id/tvTodayStatusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_not_counted"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textAllCaps="true" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvStatsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/monthly_progress"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_dark"
                    app:layout_constraintBottom_toBottomOf="@id/llTodayStatus"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/llTodayStatus" />

                <ProgressBar
                    android:id="@+id/pbMonthlyProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="20dp"
                    android:progress="45"
                    android:progressDrawable="@drawable/custom_progress_bar"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvStatsTitle" />

                <TextView
                    android:id="@+id/tvProgressDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    tools:text="14 of 31 days completed"
                    android:textSize="14sp"
                    android:textColor="@color/text_dark"
                    android:alpha="0.7"
                   app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/pbMonthlyProgress" />

                <TextView
                    android:id="@+id/tvWinRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="45%"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/ali_green"
                    app:layout_constraintBottom_toBottomOf="@id/tvProgressDetails"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvProgressDetails" />

                <View
                    android:id="@+id/statsDivider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/divider"
                    app:layout_constraintTop_toBottomOf="@id/tvProgressDetails" />

                <LinearLayout
                    android:id="@+id/llStatsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:weightSum="3"
                    app:layout_constraintTop_toBottomOf="@id/statsDivider">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Current"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:textColor="@color/text_light" />
                        <TextView
                            android:id="@+id/tvStatCurrentStreak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="5"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/ali_indigo" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Best"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:textColor="@color/text_light" />
                        <TextView
                            android:id="@+id/tvStatBestStreak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="12"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/ali_orange" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:textColor="@color/text_light" />
                        <TextView
                            android:id="@+id/tvStatTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="45"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/ali_teal" />
                    </LinearLayout>

                </LinearLayout>

                <View
                    android:id="@+id/statsDivider2"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/divider"
                    app:layout_constraintTop_toBottomOf="@id/llStatsRow" />

                <!-- Recent Activity Row -->
                <TextView
                    android:id="@+id/tvRecentTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="LAST 7 DAYS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:textColor="@color/text_light"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/statsDivider2" />

                <LinearLayout
                    android:id="@+id/llRecentActivity"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@id/tvRecentTitle">
                    <!-- Circles will be added programmatically -->
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llDailyInsight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/motivation_bg"
                    android:backgroundTint="@color/insight_bg"
                    android:orientation="vertical"
                    android:padding="16dp"
                    app:layout_constraintTop_toBottomOf="@id/llRecentActivity"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tvInsightTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/today_note"
                        android:textColor="@color/ali_indigo"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:textAllCaps="true" />

                    <TextView
                        android:id="@+id/tvInsightContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/tap_to_add_note"
                        android:textColor="@color/text_muted"
                        android:textSize="14sp" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

        <!-- Motivational Message (Floating) -->
        <TextView
            android:id="@+id/tvMotivation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="48dp"
            android:background="@drawable/motivation_bg"
            android:elevation="12dp"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:visibility="gone"
            android:translationZ="15dp"
            tools:text="You did it!"
            tools:visibility="visible" />

        <!-- ===================== WELCOME OVERLAY ===================== -->
        <FrameLayout
            android:id="@+id/welcomeOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/welcome_gradient_bg"
            android:clickable="true"
            android:focusable="true"
            android:translationZ="10dp">

            <!-- Confetti View -->
            <nl.dionsegijn.konfetti.xml.KonfettiView
                android:id="@+id/konfettiView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Floating soft decoration circles -->
            <View
                android:id="@+id/circleOne"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="-30dp"
                android:layout_marginTop="60dp"
                android:background="@drawable/welcome_circle_soft"
                android:backgroundTint="@color/ali_indigo"
                android:alpha="0"/>

            <View
                android:id="@+id/circleTwo"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="bottom|end"
                android:layout_marginBottom="120dp"
                android:layout_marginEnd="-20dp"
                android:background="@drawable/welcome_circle_soft"
                android:backgroundTint="@color/ali_teal"
                android:alpha="0"/>

            <View
                android:id="@+id/circleThree"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center|top"
                android:layout_marginTop="140dp"
                android:background="@drawable/welcome_circle_soft"
                android:backgroundTint="@color/ali_coral"
                android:alpha="0"/>

            <!-- Center welcome content -->
            <LinearLayout
                android:id="@+id/welcomeContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/welcomeBadge"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/welcome_badge_bg"
                    android:alpha="0"
                    android:scaleX="0"
                    android:scaleY="0">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_welcome_check" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvWelcomeLine1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:alpha="0"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/welcome_title"
                    android:textColor="@color/text_dark"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/tvWelcomeLine2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0"
                    android:fontFamily="sans-serif-medium"
                    android:text="Ali Hussein"
                    android:textColor="@color/text_dark"
                    android:textSize="34sp" />

                <TextView
                    android:id="@+id/tvWelcomeSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:alpha="0"
                    android:text="@string/welcome_subtitle"
                    android:textColor="@color/welcome_text_sub"
                    android:textSize="14sp" />

                <!-- Guides Section -->
                <LinearLayout
                    android:id="@+id/llGuides"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:alpha="0"
                    android:gravity="start"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/guide_tap"
                        android:textColor="@color/text_muted"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/guide_check"
                        android:textColor="@color/text_muted"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/guide_streak"
                        android:textColor="@color/text_muted"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/guide_stats"
                        android:textColor="@color/text_muted"
                        android:textSize="16sp" />

                </LinearLayout>

                <Button
                    android:id="@+id/btnWelcomeOk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:alpha="0"
                    android:backgroundTint="@color/ali_indigo"
                    android:paddingStart="40dp"
                    android:paddingEnd="40dp"
                    android:text="@string/ok"
                    android:textColor="@color/white" />

            </LinearLayout>

        </FrameLayout>
    </FrameLayout>

    <!-- ===================== SIDE MENU ===================== -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@color/surface_white">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_header"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_dark"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:background="@color/divider"/>

            <TextView
                android:id="@+id/navJumpToToday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/nav_jump_today"
                android:textSize="15sp"
                android:textColor="@color/text_dark"
                android:background="?attr/selectableItemBackground"/>

            <TextView
                android:id="@+id/navViewHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/nav_view_history"
                android:textSize="15sp"
                android:textColor="@color/text_dark"
                android:background="?attr/selectableItemBackground"/>

            <LinearLayout
                android:id="@+id/navToggleTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/nav_dark_mode"
                    android:textSize="15sp"
                    android:textColor="@color/text_dark"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/themeSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"/>
            </LinearLayout>

            <TextView
                android:id="@+id/navAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/nav_about"
                android:textSize="15sp"
                android:textColor="@color/text_dark"
                android:background="?attr/selectableItemBackground"/>

            <TextView
                android:id="@+id/navEditName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/nav_edit_name"
                android:textSize="15sp"
                android:textColor="@color/text_dark"
                android:background="?attr/selectableItemBackground"/>

            <TextView
                android:id="@+id/navReminderTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/nav_reminder_time"
                android:textSize="17sp"
                android:textColor="@color/text_dark"
                android:background="?attr/selectableItemBackground"/>

        </LinearLayout>

    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>
